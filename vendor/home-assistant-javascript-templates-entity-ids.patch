diff --git a/tests/12 - entity-subscription-filter.test.ts b/tests/12 - entity-subscription-filter.test.ts
new file mode 100644
index 0000000..8a53c2e
--- /dev/null
+++ b/tests/12 - entity-subscription-filter.test.ts	
@@ -0,0 +1,106 @@
+import {
+    HomeAssistantJavaScriptTemplates,
+    HomeAssistantJavaScriptTemplatesRenderer
+} from '../src/classes';
+import { HOME_ASSISTANT_ELEMENT } from './constants';
+import { EVENT } from '../src/constants';
+
+const flushSubscription = () => new Promise(process.nextTick);
+
+describe('entity subscription filter', () => {
+
+    let renderer: HomeAssistantJavaScriptTemplatesRenderer;
+    let cancelSubscriptions: jest.Mock[];
+    let subscribeMessage: jest.Mock;
+
+    beforeEach(async () => {
+        cancelSubscriptions = [];
+        subscribeMessage = jest.fn(() => {
+            const cancelSubscription = jest.fn();
+            cancelSubscriptions.push(cancelSubscription);
+            return Promise.resolve(cancelSubscription);
+        });
+        window.hassConnection = Promise.resolve({
+            conn: {
+                subscribeMessage
+            }
+        });
+        const compiler = new HomeAssistantJavaScriptTemplates(HOME_ASSISTANT_ELEMENT);
+        renderer = await compiler.getRenderer();
+    });
+
+    afterEach(() => {
+        renderer.cleanTracked();
+    });
+
+    it('should subscribe only to Home Assistant entities, without refs or client-side variables', async () => {
+        renderer.trackTemplate(
+            `
+                const test = ref('test');
+                return panel_url + lang + test.value + states('light.woonkamer_lamp');
+            `,
+            jest.fn()
+        );
+        await renderer.init();
+        expect(subscribeMessage).toHaveBeenCalledTimes(1);
+        expect(subscribeMessage).toHaveBeenCalledWith(
+            expect.any(Function),
+            {
+                type: EVENT.SUBSCRIBE_ENTITIES,
+                entity_ids: ['light.woonkamer_lamp']
+            }
+        );
+    });
+
+    it('should resubscribe once when templates track new entities and cancel the previous subscription afterwards', async () => {
+        renderer.trackTemplate('states("light.woonkamer_lamp")', jest.fn());
+        await renderer.init();
+        renderer.trackTemplate('states("sensor.slaapkamer_temperatuur")', jest.fn());
+        renderer.trackTemplate('states("binary_sensor.koffiezetapparaat_aan")', jest.fn());
+        await flushSubscription();
+        expect(subscribeMessage).toHaveBeenCalledTimes(2);
+        expect(subscribeMessage).toHaveBeenNthCalledWith(
+            2,
+            expect.any(Function),
+            {
+                type: EVENT.SUBSCRIBE_ENTITIES,
+                entity_ids: [
+                    'binary_sensor.koffiezetapparaat_aan',
+                    'light.woonkamer_lamp',
+                    'sensor.slaapkamer_temperatuur'
+                ]
+            }
+        );
+        expect(cancelSubscriptions[0]).toHaveBeenCalledTimes(1);
+        expect(cancelSubscriptions[1]).not.toHaveBeenCalled();
+    });
+
+    it('should not resubscribe when the tracked entities do not change', async () => {
+        const template = 'states("light.woonkamer_lamp")';
+        renderer.trackTemplate(template, jest.fn());
+        await renderer.init();
+        renderer.trackTemplate(template, jest.fn());
+        await flushSubscription();
+        expect(subscribeMessage).toHaveBeenCalledTimes(1);
+    });
+
+    it('should cancel the subscription when no Home Assistant entity is tracked anymore', async () => {
+        const untrack = renderer.trackTemplate('states("light.woonkamer_lamp")', jest.fn());
+        await renderer.init();
+        untrack();
+        await flushSubscription();
+        expect(subscribeMessage).toHaveBeenCalledTimes(1);
+        expect(cancelSubscriptions[0]).toHaveBeenCalledTimes(1);
+    });
+
+    it('should cancel the subscription when stop is called', async () => {
+        renderer.trackTemplate('states("light.woonkamer_lamp")', jest.fn());
+        await renderer.init();
+        renderer.stop();
+        expect(cancelSubscriptions[0]).toHaveBeenCalledTimes(1);
+        renderer.trackTemplate('states("sensor.slaapkamer_temperatuur")', jest.fn());
+        await flushSubscription();
+        expect(subscribeMessage).toHaveBeenCalledTimes(1);
+    });
+
+});
