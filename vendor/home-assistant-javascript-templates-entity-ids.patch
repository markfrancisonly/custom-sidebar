-        this._cancelSubscription!();
+        this._subscribedEntityIds = '';
+        this._cancelSubscription?.();
+        this._cancelSubscription = undefined;
+    }
+
+    // Only Home Assistant entities: refs and client-side variables never come from subscribe_entities
+    private _getTrackedEntityIds(): string[] {
+        return Array.from(this._subscriptions.keys())
+            .filter((id: string): boolean => id.includes('.') && !id.startsWith(`${REF_PREFIX}.`))
+            .sort();
+    }
+
+    private _syncEntitySubscription(): Promise<void> {
+        this._entitySubscriptionSync = this._entitySubscriptionSync
+            .catch(() => undefined)
+            .then(() => this._updateEntitySubscription());
+        return this._entitySubscriptionSync;
+    }
+
+    // Subscribing to an empty entity_ids list would mean every entity, so subscribe only when something is tracked
+    private async _updateEntitySubscription(): Promise<void> {
+        if (!this._subscribed) {
+            return;
+        }
+        const entityIds = this._getTrackedEntityIds();
+        const key = entityIds.join(',');
+        if (key === this._subscribedEntityIds) {
+            return;
+        }
+        const previousCancelSubscription = this._cancelSubscription;
+        let cancelSubscription: CancelSubscription | undefined;
+        if (entityIds.length) {
+            const hassConnection = await window.hassConnection;
+            cancelSubscription = await hassConnection.conn.subscribeMessage<SubscribeEntityEvent>(
+                (event) => this._entityWatchCallback(event),
+                {
+                    type: EVENT.SUBSCRIBE_ENTITIES,
+                    entity_ids: entityIds
+                }
+            );
+        }
+        if (!this._subscribed) {
+            cancelSubscription?.();
+            return;
+        }
+        this._cancelSubscription = cancelSubscription;
+        this._subscribedEntityIds = key;
+        previousCancelSubscription?.();
+    }
+
+    private _scheduleEntitySubscriptionSync(): void {
+        if (!this._subscribed || this._entitySubscriptionSyncScheduled) {
+            return;
+        }
+        this._entitySubscriptionSyncScheduled = true;
+        queueMicrotask(() => {
+            this._entitySubscriptionSyncScheduled = false;
+            this._syncEntitySubscription().catch((error: unknown) => {
+                if (this._throwWarnings) {
+                    console.warn(error);
+                }
+            });
+        });
     }
 
 	private _entityWatchCallback(event: SubscribeEntityEvent) {        
